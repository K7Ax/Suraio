# Sura / سُرى — environment variable template.
# Copy to `.env` and fill with real values. NEVER commit the real `.env`.
# Values below are placeholders only.
#
# Three distinct trust zones — do not mix them up:
#   1) CLIENT config   → safe to ship in the browser (public by design)
#   2) SERVER process  → only on the machine running bot.js (never in browser)
#   3) SUPABASE SECRETS→ set in Supabase Dashboard → Edge Functions → Secrets
#                        (never in this file, never in the browser)

# ── 1) CLIENT config (public; currently inlined in index.html SURA_CONFIG) ──
# The anon/publishable key is meant to be public. Real protection is RLS.
SUPABASE_URL=https://YOUR_PROJECT_ref.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
# Admin dashboard gate (single-admin MVP). Identity only — not a secret.
ADMIN_EMAIL=you@example.com

# ── 2) SERVER process — bot.js ONLY (Telegram content bot) ──────────────────
# Service role bypasses RLS. NEVER expose to the browser or commit it.
SUPABASE_SERVICE_KEY=eyJ...service_role...xxxxxxxxxxxx
# Telegram bot token from @BotFather.
BOT_TOKEN=123456789:AA_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Comma-separated Telegram user IDs allowed to issue bot commands.
ADMIN_IDS=11111111,22222222
# Lets the bot call the groq-review Edge Function without a user session (it has
# none — it runs as a service). Set the SAME value as a Supabase Function secret.
# Optional: leave it unset and /genmonth still generates and gates the whole
# month, it just skips the AI review step and says so.
SURA_ADMIN_SECRET=pick_a_long_random_string
# GitHub — lets the «🐙 افتح Issue» button under each bug report file it in your
# private repo. Use a FINE-GRAINED token scoped to that ONE repository with
# `Issues: read and write` and nothing else; a classic `repo` token would let the
# bot push code, which it never needs to do.
# Optional: leave both unset and every other part of the report system works —
# the button simply answers «غير مُهيَّأ».
GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_REPO=your-username/your-private-repo

# ── 3) SUPABASE SECRETS (set in the Supabase Dashboard, NOT here) ───────────
# Listed for documentation only — do not place the real value in this repo.
# Used by the groq-hint / groq-review Edge Functions.
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
